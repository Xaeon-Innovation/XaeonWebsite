# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# API base for the browser (default /api/v1, proxied by Vercel to the Express API).
# VITE_API_BASE_URL=/api/v1

# Google Analytics 4 measurement ID (Admin → Data streams → Web). Leave empty to disable.
VITE_GA4_ID=
# Meta (Facebook) Pixel ID (Events Manager → Data sources). Leave empty to disable.
VITE_META_PIXEL_ID=

# Optional
# VITE_SITE_ORIGIN=https://xaeons.com
# VITE_OG_IMAGE_URL=
# VITE_MEETING_SCHEDULE_URL=
