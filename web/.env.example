# Express API origin (server-side fetches + /api/v1 proxy)
API_ORIGIN=https://api.xaeons.com
# Public site origin, used for canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_ORIGIN=https://xaeons.com
# Client portal + admin (existing Vite app)
NEXT_PUBLIC_APP_ORIGIN=https://app.xaeons.com
# Analytics (leave empty to disable; no cookie banner is shown then)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
